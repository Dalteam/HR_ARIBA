# Base URL of the FastAPI backend WITH /api/v1 (public: the browser calls it). Baked in at build time,
# so rebuild/redeploy after changing it. On Railway: https://<backend>.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# The employee app's address (the home-screen web page). Shown to an employee who signs in to the HR portal,
# which sends them to the app instead. On Railway: https://<employee-app>.up.railway.app
NEXT_PUBLIC_EMPLOYEE_APP_URL=http://localhost:8081

# Optional: a label shown at the bottom of the side menu to tell builds apart (e.g. the commit or the date).
NEXT_PUBLIC_BUILD_STAMP=
