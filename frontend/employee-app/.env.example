# Backend base URL, without /api/v1 and without a trailing slash. REQUIRED: there is no default, and
# `npm run build:web` (what Railway runs) stops without it. On Railway: https://<backend>.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:8000
# Local backend instead (on a phone use the computer LAN IP, not localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
