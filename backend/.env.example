# development | test | production
ENV=development

# SQLite locally. On Railway set DATABASE_URL=${{Postgres.DATABASE_URL}} (reference to the Postgres service).
DATABASE_URL=sqlite:///./dev.db
# Railway runs migrations in the pre-deploy step, so set this to false there.
RUN_MIGRATIONS_ON_STARTUP=true

# Signs session tokens. Required in production: a random string of 32+ characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=ariba-hr
JWT_AUDIENCE=ariba-hr-api
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Uploaded photos/documents. On Railway: the mount path of the Volume, e.g. /data
STORAGE_DIR=.storage

# Every browser origin allowed to call the API, comma-separated, no trailing slash: the HR web app AND the
# employee app (a web page on Railway). Locally: the Next dev server and the Expo web server.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Login throttling: per username and per client IP, in the configured window.
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_PER_USERNAME=5
LOGIN_MAX_PER_IP=20

# Maximum uploaded file size (12 MiB by default).
MAX_UPLOAD_BYTES=12582912

# First deploy only: creates this admin when there are no users yet. Remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Notification e-mails. The bell entry is also mailed to the employee named on it, with the full
# details and the PDF a template was sent with (workflow_notifications + ariba_notif_files).
# Two switches: NOTIFY_EMAIL_ENABLED must be true AND SMTP must be configured, otherwise the sender
# does nothing at all (the bell keeps working). Credentials stay in the environment, never in the DB.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ariba HR
# starttls (587) | ssl (465) | none (a relay inside the private network)
SMTP_ENCRYPTION=starttls
# Seconds between two passes of the sender; 0 turns the background loop off. A manual pass:
#   python -m app.services.notify_email
NOTIFY_EMAIL_INTERVAL_SECONDS=60
NOTIFY_EMAIL_BATCH=25
NOTIFY_EMAIL_MAX_TRIES=5
# Stage 12: how often (seconds) the app checks whether today's escalation pass is due; it runs once a day from
# 07:05 Riyadh (the expiry alerts run in the same pass). 0 turns the loop off; HR's «تشغيل الآن» still works.
WORKFLOW_ESCALATION_CHECK_SECONDS=3600
# Only notifications created at or after this instant are mailed. Leave it empty: the cut-off is then
# the stamp migration 002 wrote into ariba_app_settings['notify_email_since'] (the moment it ran), so
# the notifications that came with the migrated data are never sent. With neither, nothing is sent.
NOTIFY_EMAIL_SINCE=
# Outside production nothing is mailed to a real employee address unless it is redirected to this
# comma-separated sink — e.g. NOTIFY_EMAIL_REDIRECT_TO=qa@your-domain.example
NOTIFY_EMAIL_REDIRECT_TO=
# Set to true only when a non-production environment must really reach employees (never locally).
NOTIFY_EMAIL_ALLOW_REAL_RECIPIENTS=false
# Fallback for the links inside the e-mails when Settings → app links (ariba_app_settings['app_links'])
# is empty.
PUBLIC_APP_URL=http://localhost:3000

# Optional: a Postgres database for the Postgres migration/RLS test.
# TEST_DATABASE_URL=postgresql://localhost/ariba_hr_test
